APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# 生产环境注意事项：
# - 站点走 HTTPS 时 COOKIE_SECURE 必须为 true。
# - POSTGRES_PASSWORD / BOOTSTRAP_ADMIN_PASSWORD / MASTER_KEY_BASE64 必须换成强随机值。
# - 不要提交 .env（已在 .gitignore 中）。

# 后台 API 前缀。默认 /admin-panel；/admin 始终作为兼容前缀可用。
# 想更隐蔽就换成一个不好猜的单段路径，例如 /ops-7f3a。
ADMIN_PATH=/admin-panel
VITE_SITE_NAME=ShitIDC
VITE_SITE_LOGO_URL=
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1,::1

POSTGRES_USER=shitidc
# 必填：compose 不再提供默认口令；示例值只是占位，部署前务必替换。
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=shitidc
POSTGRES_DSN=postgres://shitidc:change_me_strong_password@postgres:5432/shitidc?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 32 random bytes encoded with base64. Example generation: openssl rand -base64 32
# Alternative: read the key from a mounted secret file (Docker Secrets / KMS-lite).
MASTER_KEY_FILE=
MASTER_KEY_BASE64=

SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=120
# Per-API-token request limit per minute (0 = only the global IP limit).
TOKEN_RATE_LIMIT_PER_MINUTE=300
# Send a mail on every successful login (through the mail.send queue).
LOGIN_NOTIFY=false
# Auto-terminate services suspended for more than N days (0 = disabled).
AUTO_TERMINATE_SUSPENDED_DAYS=0

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 首次启动创建管理员账号用；上线前必须修改，不需要时留空。
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_123456!

# Legacy environment fallback for old products without a persisted provider_id.
# New deployments should add MagicCube suppliers from Admin -> 供应商 / 上游.
MAGICCUBE_DEFAULT_BASE_URL=
MAGICCUBE_DEFAULT_USERNAME=
MAGICCUBE_DEFAULT_API_KEY=
MAGICCUBE_AUTH_MODE=legacy_login
MAGICCUBE_TOKEN_PREFIX=Bearer
MAGICCUBE_USER_HEADER=X-API-User
MAGICCUBE_API_KEY_HEADER=X-API-Key
MAGICCUBE_ALLOW_PRIVATE=false
MAGICCUBE_LOGIN_PATH=/v1/login_api
MAGICCUBE_PRODUCTS_PATH=/v1/products
MAGICCUBE_TEST_PATH=/v1/products
MAGICCUBE_CREATE_PATH=
MAGICCUBE_SUSPEND_PATH=
MAGICCUBE_UNSUSPEND_PATH=
MAGICCUBE_TERMINATE_PATH=
MAGICCUBE_RENEW_PATH=
MAGICCUBE_RETRY_CREATE=false
